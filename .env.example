PORT=3000

# ─── Captcha Strategy ──────────────────────────────────────────────────────────
# Pilih salah satu strategi berikut:
#   stealth   → Gratis, tanpa API key. Gunakan stealth plugin untuk menghindari deteksi bot.
#   manual    → Gratis, tanpa API key. Browser terbuka (non-headless), user solve captcha manual,
#               session disimpan otomatis di SESSION_FILE untuk dipakai kembali.
#   capsolver → Berbayar (ada free tier). Daftar di https://capsolver.com lalu isi API key.
#   2captcha  → Berbayar (~$2-3/1000 solve). Daftar di https://2captcha.com lalu isi API key.
CAPTCHA_STRATEGY=stealth

# API key — hanya diperlukan jika CAPTCHA_STRATEGY=capsolver atau 2captcha
CAPTCHA_API_KEY=

# Path file untuk menyimpan session cookies (hanya untuk CAPTCHA_STRATEGY=manual)
SESSION_FILE=session.json

# ─── Target & Login Credentials ───────────────────────────────────────────────
TARGET_URL=https://pep.ppatk.go.id/admin/user/login
LOGIN_EMAIL=your_email@example.com
LOGIN_PASSWORD=your_password_here

LOG_LEVEL=info
NODE_ENV=development

# ─── Proxy Configuration ──────────────────────────────────────────────────────
USE_PROXY=false
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

