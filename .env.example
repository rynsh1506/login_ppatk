# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
# Port di mana server Express.js akan berjalan.
# Required/Optional: Optional
# Default: 3000
PORT=3000

# Menentukan apakah browser dijalankan secara headless (tanpa visual) atau tidak (true/false).
# Set ke false jika ingin memantau jalannya browser secara visual.
# Required/Optional: Optional
# Default: true
HEADLESS=true

# Environment jalannya aplikasi (development / production).
# Required/Optional: Optional
# Default: development
NODE_ENV=development

# Tingkat logging yang dicatat ke konsol/file (error, warn, info, debug).
# Required/Optional: Optional
# Default: info
LOG_LEVEL=info


# ==============================================================================
# TARGET & LOGIN CREDENTIALS
# ==============================================================================
# URL halaman login target PPATK.
# Required/Optional: Required
# Default: https://pep.ppatk.go.id/admin/user/login
TARGET_URL=https://pep.ppatk.go.id/admin/user/login

# Email/Username untuk masuk ke sistem PPATK.
# Required/Optional: Required
LOGIN_EMAIL=your_email@example.com

# Password untuk akun masuk PPATK Anda.
# Required/Optional: Required
LOGIN_PASSWORD=your_password_here


# ==============================================================================
# CAPTCHA CONFIGURATION
# ==============================================================================
# Strategi penyelesaian reCAPTCHA yang digunakan:
#   stealth       → Gratis, tanpa API key. Menggunakan plugin stealth untuk menghindari deteksi bot.
#   manual        → Gratis, tanpa API key. Membuka browser visual, user menyelesaikan captcha secara manual,
#                   lalu menekan ENTER di terminal. Cookie disimpan otomatis agar tidak login ulang.
#   whisper-local → Gratis, tanpa API key. Menggunakan Whisper lokal untuk memecahkan audio challenge.
#   capsolver     → Berbayar. Membutuhkan API Key dari capsolver.com.
#   2captcha      → Berbayar. Membutuhkan API Key dari 2captcha.com.
# Required/Optional: Optional
# Default: stealth
CAPTCHA_STRATEGY=stealth

# API Key untuk Capsolver atau 2Captcha (Hanya diperlukan jika menggunakan capsolver/2captcha).
# Required/Optional: Conditional (Wajib jika CAPTCHA_STRATEGY = capsolver / 2captcha)
# Default: (kosong)
CAPTCHA_API_KEY=

# Nama file untuk menyimpan session cookies (Hanya digunakan jika CAPTCHA_STRATEGY = manual).
# Required/Optional: Optional
# Default: session.json
SESSION_FILE=session.json


# ==============================================================================
# PROXY CONFIGURATION
# ==============================================================================
# Apakah aplikasi akan menggunakan proxy server untuk koneksi (true / false).
# Required/Optional: Optional
# Default: false
USE_PROXY=false

# Alamat server proxy beserta portnya (misal: http://12.34.56.78:8080).
# Required/Optional: Optional
PROXY_SERVER=

# Username otentikasi proxy server jika diperlukan.
# Required/Optional: Optional
PROXY_USERNAME=

# Password otentikasi proxy server jika diperlukan.
# Required/Optional: Optional
PROXY_PASSWORD=
